
@startuml
title S2 - Mengerjakan Simulasi & Menerima Feedback

actor "Job Seeker" as U
participant "UI" as UI
participant "Simulation" as SIM
participant "Feedback & Progress" as FP
database "Database" as DB

U -> UI: Isi jawaban, klik "Kirim"
UI -> SIM: submit_answers(attempt_id, answers)
SIM -> DB: get_attempt_tasks(attempt_id)
DB --> SIM: user_id, sudah_dikirim, daftar task + kunci jawaban

alt Attempt sudah pernah dikirim
  SIM --> UI: error "sudah dikirim"
  UI --> U: "Simulasi ini sudah diselesaikan"
else Ada task belum dijawab
  SIM --> UI: error validasi
  UI --> U: "Semua task wajib diisi"
else Semua task terjawab
  SIM -> SIM: count_correct(answers, tasks)
  SIM -> SIM: evaluate_simulation(correct, total)
  SIM -> FP: save_result(user_id, attempt_id, score, status)
  FP -> DB: simpan hasil
  alt Berhasil disimpan
    DB --> FP: OK
    FP --> SIM: feedback sesuai status
    SIM --> UI: skor + status + feedback
    UI --> U: Tampilkan hasil
  else Gagal menyimpan
    DB --> FP: error
    FP --> SIM: error
    SIM --> UI: error simpan
    UI --> U: "Hasil belum tersimpan, coba lagi"
  end
end
@enduml
