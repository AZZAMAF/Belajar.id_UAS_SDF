@startuml
title CareerUp - Use Case Diagram
left to right direction
skinparam packageStyle rectangle

actor "Job Seeker" as JS
actor "Admin CareerUp" as AD

rectangle "CareerUp" {

  package "Auth & Profile" {
    usecase "Register" as UC1
    usecase "Login" as UC2
  }

  package "Job Explorer" {
    usecase "Browse Jobs" as UC3
    usecase "View Required Skills" as UC4
    usecase "Set Target Job" as UC5
  }

  package "Learning" {
    usecase "Learn Skill Material" as UC6
    usecase "Do Interactive Practice" as UC7
  }

  package "Simulation" {
    usecase "Do Job Simulation" as UC8
    usecase "Choose Simulation Scenario" as UC9
    usecase "Submit Task Answers" as UC10
  }

  package "Feedback & Progress" {
    usecase "Generate Feedback" as UC11
    usecase "View Feedback" as UC12
    usecase "Retry Simulation" as UC13
    usecase "View Progress" as UC14
  }

  package "Content Management" {
    usecase "Manage Jobs & Skills" as UC15
    usecase "Manage Learning Materials" as UC16
    usecase "Manage Simulation Tasks" as UC17
    usecase "Manage Feedback Rules" as UC18
  }
}

' --- Job Seeker ---
JS --> UC1
JS --> UC2
JS --> UC3
JS --> UC4
JS --> UC5
JS --> UC6
JS --> UC7
JS --> UC8
JS --> UC12
JS --> UC14

' --- Admin ---
AD --> UC2
AD --> UC15
AD --> UC16
AD --> UC17
AD --> UC18

' --- Include: selalu terjadi ---
UC8 ..> UC9 : <<include>>
UC8 ..> UC10 : <<include>>
UC10 ..> UC11 : <<include>>

' --- Extend: kadang terjadi ---
UC13 ..> UC12 : <<extend>>

note right of UC13
  Hanya muncul jika status
  "Perlu Latihan Lagi"
end note
@enduml
