@startuml
title CareerUp - Use Case Diagram
left to right direction
skinparam packageStyle rectangle

actor "Job Seeker" as JS
actor "Admin CareerUp" as AD

rectangle "CareerUp" {

  package "Auth & Profile" {
    usecase "Register" as Register
    usecase "Login" as Login
    usecase "Set Target Job" as SetTarget
  }

  package "Job Explorer" {
    usecase "Browse Jobs" as BrowseJobs
    usecase "View Required Skills" as ViewSkills
    usecase "View Learning Roadmap" as ViewRoadmap
  }

  package "Learning" {
    usecase "Learn Skill Material" as LearnMaterial
    usecase "Do Interactive Practice" as DoPractice
  }

  package "Simulation" {
    usecase "Do Job Simulation" as DoSim
    usecase "Choose Simulation Scenario" as ChooseScenario
    usecase "Submit Task Answers" as SubmitAnswers
  }

  package "Feedback & Progress" {
    usecase "Generate Feedback" as GenFeedback
    usecase "View Feedback" as ViewFeedback
    usecase "Retry Simulation" as Retry
    usecase "View Progress" as ViewProgress
  }

  package "Content Management" {
    usecase "Manage Jobs & Skills" as MgJobs
    usecase "Manage Learning Materials" as MgMaterials
    usecase "Manage Simulation Tasks" as MgTasks
    usecase "Manage Feedback Rules" as MgRules
  }
}

' --- Job Seeker ---
JS --> Register
JS --> Login
JS --> SetTarget
JS --> BrowseJobs
JS --> ViewSkills
JS --> ViewRoadmap
JS --> LearnMaterial
JS --> DoPractice
JS --> DoSim
JS --> ViewFeedback
JS --> Retry
JS --> ViewProgress

' --- Admin ---
AD --> Login
AD --> MgJobs
AD --> MgMaterials
AD --> MgTasks
AD --> MgRules

' --- Include: selalu terjadi ---
DoSim ..> ChooseScenario : <<include>>
DoSim ..> SubmitAnswers : <<include>>
SubmitAnswers ..> GenFeedback : <<include>>

' --- Extend: kadang terjadi ---
Retry ..> ViewFeedback : <<extend>>

note right of Retry
  Extension point: hanya muncul
  jika status "Perlu Latihan Lagi"
end note

note "Semua use case selain Register dan Login\nmensyaratkan pengguna sudah login." as NLogin
NLogin .. Login
@enduml
